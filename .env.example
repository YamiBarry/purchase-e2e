# ── 工作空间 ──
WORK_DIR=/home/e2e/workspace/purchase
CODE_DIR=/home/e2e/code/yami

# ── HTTP ──
PORT=8900

# ── 进程池 ──
MAX_PROCS=6
WARM_POOL_SIZE=2
IDLE_TIMEOUT=1800

# ── Prompt ──
PROMPT_TIMEOUT=1800
SESSION_SIZE_LIMIT=200000

# ── 记忆 ──
MEMORY_SUMMARY_INTERVAL=10
MEMORY_RECALL_DAYS=30

# ── 企微 Bot ──
BOT_SECRET=your_bot_secret_here

# ── Admin 面板 ──
ADMIN_BASE_URL=http://your-server-ip:3000

# ── 企微通讯录（可选，不填则用户显示为userId）──
WECOM_CORPID=your_corpid_here
WECOM_SECRET=your_wecom_secret_here

# ── Central API ──
CENTRAL_ENV=prd

# ── Vesta OAuth（可选）──
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here
VESTA_BASE_URL=https://vesta.yamibuy.net

# ── Lumi AI（可选）──
LUMI_BASE_URL=https://lumi.yamibuy.net
LUMI_API_KEY=your_lumi_api_key_here

# ── 知识库（可选）──
BIZ_KB_BASE_URL=https://brain.yami.com
BIZ_KB_API_KEY=your_kb_api_key_here
